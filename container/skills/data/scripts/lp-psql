#!/usr/bin/env bash
# psql against an LP production database. Connection details + password are pulled
# on demand from a 1Password item via the `op` CLI.
#
# Default item: "LP Production" (vault "LP op-cli") — points at the main-cluster-2
# production read replica, db `lp_core_production`, user `metabase`.
#
# Switch databases by overriding LP_PSQL_OP_ITEM:
#   LP_PSQL_OP_ITEM="LP Event Store Production" lp-psql -c "SELECT 1;"
#
# Per-field env overrides also work: LP_PSQL_HOST, LP_PSQL_PORT, LP_PSQL_USER,
# LP_PSQL_DB. Empty op fields fall back to these or the script defaults.
#
# Rotate: update the 1Password item; next invocation picks it up.

set -euo pipefail

OP_VAULT="${LP_PSQL_OP_VAULT:-LP op-cli}"
OP_ITEM="${LP_PSQL_OP_ITEM:-LP Production}"
OP_FIELD="${LP_PSQL_OP_FIELD:-password}"

command -v op >/dev/null 2>&1 || { echo "op CLI not found. Install with: brew install --cask 1password-cli" >&2; exit 1; }

# Pull all connection fields from the 1P item in one round trip.
if ! ITEM_JSON=$(op item get "$OP_ITEM" --vault "$OP_VAULT" --format json 2>/dev/null); then
  echo "Failed to read '$OP_ITEM' from 1Password vault '$OP_VAULT'." >&2
  echo "Sign in with 'op signin' (or set OP_SERVICE_ACCOUNT_TOKEN), then retry." >&2
  exit 1
fi

field() { jq -r --arg label "$1" '.fields[] | select(.label==$label) | .value // empty' <<<"$ITEM_JSON"; }

OP_HOST=$(field host)
OP_PORT=$(field port)
OP_DB=$(field database)
OP_USER=$(field username)
PGPASSWORD=$(field "$OP_FIELD")

HOST="${LP_PSQL_HOST:-${OP_HOST:-main-cluster-2-production-metabase-ro.cxlfzksp5aii.us-east-1.rds.amazonaws.com}}"
PORT="${LP_PSQL_PORT:-${OP_PORT:-5432}}"
USER_NAME="${LP_PSQL_USER:-${OP_USER:-metabase}}"
DB="${LP_PSQL_DB:-${OP_DB:-lp_core_production}}"

[ -n "$PGPASSWORD" ] || { echo "Empty '$OP_FIELD' on '$OP_ITEM', aborting." >&2; exit 1; }

export PGPASSWORD
exec psql "host=$HOST port=$PORT dbname=$DB user=$USER_NAME sslmode=require" "$@"
