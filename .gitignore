# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Nested git repos (LP code clones, knowledge base) — managed separately
/shared/*/

# Groups - track per-group config (system prompt + container config) for
# instance reproducibility; ignore composer artifacts and runtime state.
groups/*
!groups/*/
groups/*/*
!groups/*/CLAUDE.local.md
!groups/*/container.json

# Composer-managed artifacts (regenerated every spawn)
**/.claude-shared.md
**/.claude-fragments/

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

# Claude Code scheduled-tasks lock (live PID + session id, runtime artifact)
.claude/scheduled_tasks.lock

agents-sdk-docs

# container/skills/ is populated by scripts/sync-shared-skills.ts from
# lfontes-mono/skills/. The synced contents are gitignored — canonical
# source is lfontes-mono. (If upstream ever adds tracked files under this
# path, they'd remain tracked despite this rule — gitignore only affects
# untracked files.)
container/skills/*
