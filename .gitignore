# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth (repo-root only — `data/` unanchored would also
# match container/skills/data/ from the lfontes-mono sync).
/store/
/data/
/logs/

# Nested git repos (LP code clones, knowledge base) — managed separately
/shared/*/

# Groups - track per-group config (system prompt + container config) for
# instance reproducibility; ignore composer artifacts and runtime state.
groups/*
!groups/*/
groups/*/*
!groups/*/CLAUDE.local.md
!groups/*/container.json

# Composer-managed artifacts (regenerated every spawn)
**/.claude-shared.md
**/.claude-fragments/

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

# Skill contents are synced from lfontes-mono (scripts/sync-shared-skills.ts).
# The manifest stays tracked; skill dirs are disposable copies.
container/skills/*/

# Claude Code scheduled-tasks lock (live PID + session id, runtime artifact)
.claude/scheduled_tasks.lock

agents-sdk-docs
